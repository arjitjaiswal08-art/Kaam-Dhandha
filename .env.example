# GramConnect Environment Variables
# Copy this file to .env and fill in your values

# Secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret-key

# Database URL (for production, use PostgreSQL)
# SQLite (development): sqlite:///village_jobs.db
# PostgreSQL: postgresql://user:password@host:5432/database
DATABASE_URL=sqlite:///village_jobs.db

# Flask environment
FLASK_ENV=production
FLASK_DEBUG=False

# Application settings
APP_NAME=GramConnect
